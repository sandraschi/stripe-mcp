# stripe-mcp Environment Configuration

# Server ports
PORT=11165
WEB_PORT=11166

# Stripe Credentials
# Default mode is test. Replace with your Restricted API Key (rk_test_... or rk_live_...)
STRIPE_API_KEY=rk_test_mock_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret
STRIPE_MODE=test
# Blocks issue_refund, subscription cancel, customer create, and all checkout/invoice
# creation. Set to false only when you deliberately want the agent to be able to
# move money or create live Stripe objects.
STRIPE_READ_ONLY=true

# Safety caps (only relevant when STRIPE_READ_ONLY=false) -- see docs/SAFETY.md
MAX_REFUND_AMOUNT_EUR=500.00
MAX_CHECKOUT_AMOUNT_EUR=5000.00
MAX_REFUND_TOTAL_EUR_PER_DAY=2000.00
MAX_CHECKOUT_TOTAL_EUR_PER_DAY=20000.00
# Refund/cancel targets must have been observed via a prior list call in this
# session. Real-mode only; see docs/SAFETY.md before disabling.
STRIPE_REQUIRE_OBSERVED_IDS=true

# Regional & Tax Defaults
DEFAULT_CURRENCY=EUR
DEFAULT_COUNTRY=AT
DEFAULT_VAT_RATE=0.20
ENABLE_EU_VAT_VALIDATION=true
